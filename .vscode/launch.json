{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "[cpp] main",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/libastfri-cpp/main/main_CPP",
            "args": ["../resources/samples/cpp/test_examples/example_inheritance.cpp"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },

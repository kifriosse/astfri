{
  "costs": {
    "remove_DOC": "cost of deleting a node",
    "remove": 1,

    "insert_DOC": "cost of inserting a node",
    "insert": 1,

    "rename_DOC": "cost of renaming/relabeling a node whose kind or attributes enabled (set to true) in 'attributes' below are not equal",
    "rename": 1
  },
  "attributes": {
    "IntLiteralExpr_DOC":        { "val": "compare integer literal values (1 vs 2)" },
    "IntLiteralExpr":            { "val": true },

    "FloatLiteralExpr_DOC":      { "val": "compare floating-point literal values (1.5 vs 2.5)" },
    "FloatLiteralExpr":          { "val": true },

    "CharLiteralExpr_DOC":       { "val": "compare character literal values ('a' vs 'b')" },
    "CharLiteralExpr":           { "val": true },

    "StringLiteralExpr_DOC":     { "val": "compare string literal contents (abc vs xyz)" },
    "StringLiteralExpr":         { "val": true },

    "BoolLiteralExpr_DOC":       { "val": "compare boolean literal values (true vs false)" },
    "BoolLiteralExpr":           { "val": true },

    "BinOpExpr_DOC":             { "op": "compare binary operators (+ vs -)" },
    "BinOpExpr":                 { "op": true },

    "UnaryOpExpr_DOC":           { "op": "compare unary operators (-x vs !x)" },
    "UnaryOpExpr":               { "op": true },

    "ParamVarRefExpr_DOC":       { "name": "compare names of referenced parameters" },
    "ParamVarRefExpr":           { "name": false },

    "LocalVarRefExpr_DOC":       { "name": "compare names of referenced local variables" },
    "LocalVarRefExpr":           { "name": false },

    "MemberVarRefExpr_DOC":      { "name": "compare names of referenced member variables" },
    "MemberVarRefExpr":          { "name": false },

    "GlobalVarRefExpr_DOC":      { "name": "compare names of referenced global variables" },
    "GlobalVarRefExpr":          { "name": false },

    "ClassRefExpr_DOC":          { "name": "compare names of classes referenced in expressions" },
    "ClassRefExpr":              { "name": false },

    "FunctionCallExpr_DOC":      { "name": "compare names of called functions" },
    "FunctionCallExpr":          { "name": false },

    "MethodCallExpr_DOC":        { "name": "compare names of called methods" },
    "MethodCallExpr":            { "name": false },



    "LocalVarDefStmt_DOC":       { "name": "compare names of defined local variables" },
    "LocalVarDefStmt":           { "name": false },

    "ParamVarDefStmt_DOC":       { "name": "compare names of defined parameters" },
    "ParamVarDefStmt":           { "name": false },

    "GlobalVarDefStmt_DOC":      { "name": "compare names of defined global variables" },
    "GlobalVarDefStmt":          { "name": false },

    "MemberVarDefStmt_DOC":      { "name": "compare names of defined member variables", "access": "compare access modifiers", "staticity": "compare static vs non-static" },
    "MemberVarDefStmt":          { "name": false, "access": true, "staticity": true },

    "FunctionDefStmt_DOC":       { "name": "compare names of defined functions" },
    "FunctionDefStmt":           { "name": false },

    "MethodDefStmt_DOC":         { "access": "compare access modifiers", "virtuality": "compare virtuality (non-virtual, virtual, pure virtual)", "staticity": "compare static vs non-static" },
    "MethodDefStmt":             { "access": true, "virtuality": true, "staticity": true },

    "ConstructorDefStmt_DOC":    { "access": "compare access modifiers of constructors" },
    "ConstructorDefStmt":        { "access": true },

    "GenericParam_DOC":          { "name": "compare names of template parameters", "constraint": "compare constraints of template parameters" },
    "GenericParam":              { "name": false, "constraint": false },

    "ClassDefStmt_DOC":          { "name": "compare names of defined classes" },
    "ClassDefStmt":              { "name": false },

    "InterfaceDefStmt_DOC":      { "name": "compare names of defined interfaces" },
    "InterfaceDefStmt":          { "name": false },

    "BaseInitializerStmt_DOC":   { "name": "compare names of base classes in constructor initializer lists" },
    "BaseInitializerStmt":       { "name": false },

    "MemberInitializerStmt_DOC": { "name": "compare names of members in constructor initializer lists" },
    "MemberInitializerStmt":     { "name": false },



    "ClassType_DOC":             { "name": "compare class names where a class is used as a type", "scope": "compare namespaces of those classes" },
    "ClassType":                 { "name": false, "scope": false },

    "InterfaceType_DOC":         { "name": "compare interface names where an interface is used as a type", "scope": "compare namespaces of those interfaces" },
    "InterfaceType":             { "name": false, "scope": false },

    "LambdaType_DOC":            { "name": "compare names of lambda types" },
    "LambdaType":                { "name": false },

    "IncompleteType_DOC":        { "name": "compare names of types that could not be resolved (name is known)" },
    "IncompleteType":            { "name": false }
  }
}
